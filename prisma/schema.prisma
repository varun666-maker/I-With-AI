generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COMPANY_ADMIN
  CANDIDATE
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA
  CANDIDATE_INVITATION
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  DELETED
}

enum ResumeAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  DELETED
}

enum AttemptMode {
  PREP
  HIRING
}

enum AttemptRoundType {
  APTITUDE
  CODING
  INTERVIEW
}

enum AttemptStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  CANCELLED
}

enum ConsentType {
  AI_PROCESSING
  STORAGE
  RECORDING
  PROCTORING
}

enum DataRequestType {
  EXPORT
  DELETION
  ACCOUNT_LOCK
}

enum DataRequestStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED
}

model User {
  id                    String             @id @default(uuid()) @db.Uuid
  emailNormalized       String             @unique @map("email_normalized")
  passwordHash          String             @map("password_hash")
  displayName           String             @map("display_name")
  role                  UserRole           @default(STUDENT)
  status                UserStatus         @default(ACTIVE)
  emailVerifiedAt       DateTime?          @map("email_verified_at")
  requirePasswordChange Boolean            @default(false) @map("require_password_change")
  lastLoginAt           DateTime?          @map("last_login_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")
  sessions              UserSession[]
  authTokens            AuthToken[]
  profile               Profile?
  education            Education[]
  userSkills            UserSkill[]
  mediaAssets           MediaAsset[]
  resumes               Resume[]
  attempts              AssessmentAttempt[]
  interviewSessions     InterviewSession[]
  consents              ConsentRecord[]
  dataRequests          DataRequest[]       @relation("RequestedDataRequests")
  subjectDataRequests   DataRequest[]       @relation("SubjectDataRequests")
  auditLogs             AuditLog[]
  jobs                  Job[]
  notifications         Notification[]

  @@map("users")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid @map("user_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  ipHash          String?   @map("ip_hash")
  userAgentHash   String?   @map("user_agent_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model AuthToken {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid @map("user_id")
  tokenHash     String           @unique @map("token_hash")
  purpose       AuthTokenPurpose
  expiresAt     DateTime         @map("expires_at")
  consumedAt    DateTime?        @map("consumed_at")
  attemptCount  Int              @default(0) @map("attempt_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_tokens")
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid @map("user_id")
  phone             String?
  dateOfBirth       DateTime? @map("date_of_birth")
  city              String?
  linkedinUrl       String?  @map("linkedin_url")
  githubUrl         String?  @map("github_url")
  portfolioUrl      String?  @map("portfolio_url")
  bio               String?
  targetRole        String?  @map("target_role")
  experienceLevel   String?  @map("experience_level")
  expectedSalary    String?  @map("expected_salary")
  noticePeriod      String?  @map("notice_period")
  remotePreference  String?  @map("remote_preference")
  shiftPreference   String?  @map("shift_preference")
  preferredRoles    Json?    @map("preferred_roles_json")
  preferredLocations Json?   @map("preferred_locations_json")
  completenessPercent Int    @default(0) @map("completeness_percent")
  visibilityPolicy  String   @default("private") @map("visibility_policy")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Education {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid @map("user_id")
  degree         String
  institution    String
  field          String?
  graduationYear Int?     @map("graduation_year")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("education")
}

model Skill {
  id           String      @id @default(uuid()) @db.Uuid
  normalizedName String    @unique @map("normalized_name")
  category     String?
  userSkills   UserSkill[]

  @@map("skills")
}

model UserSkill {
  userId      String  @db.Uuid @map("user_id")
  skillId     String  @db.Uuid @map("skill_id")
  proficiency String?
  years       Decimal? @db.Decimal(4, 1)
  position    Int     @default(0)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model MediaAsset {
  id              String      @id @default(uuid()) @db.Uuid
  ownerUserId     String?     @db.Uuid @map("owner_user_id")
  assetType       String      @map("asset_type")
  storageProvider String      @default("cloudinary") @map("storage_provider")
  storageKey      String      @map("storage_key")
  mimeType        String      @map("mime_type")
  sizeBytes       BigInt      @map("size_bytes")
  checksum        String
  durationSeconds Int?       @map("duration_seconds")
  status          MediaStatus @default(PENDING)
  retentionUntil  DateTime?   @map("retention_until")
  deletionReason  String?     @map("deletion_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  deletedAt       DateTime?   @map("deleted_at")
  owner           User?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  resumes         Resume[]

  @@index([ownerUserId, assetType, status])
  @@index([retentionUntil, status])
  @@map("media_assets")
}

model Resume {
  id              String       @id @default(uuid()) @db.Uuid
  ownerUserId     String       @db.Uuid @map("owner_user_id")
  mediaAssetId    String       @db.Uuid @map("media_asset_id")
  fileName        String       @map("file_name")
  extractedText   String?      @map("extracted_text")
  status          ResumeStatus @default(UPLOADED)
  retentionUntil  DateTime?    @map("retention_until")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  analyses        ResumeAnalysis[]

  @@index([ownerUserId, createdAt])
  @@map("resumes")
}

model ResumeAnalysis {
  id                 String               @id @default(uuid()) @db.Uuid
  resumeId           String               @db.Uuid @map("resume_id")
  provider           String
  model              String
  promptVersion      String               @map("prompt_version")
  status             ResumeAnalysisStatus @default(QUEUED)
  atsScore           Int?                 @map("ats_score")
  overallScore       Int?                 @map("overall_score")
  jobFitScore        Int?                 @map("job_fit_score")
  summary            String?
  reportJson         Json?                @map("report_json")
  wordCount          Int?                 @map("word_count")
  pageCount          Int?                 @map("page_count")
  attempt            Int                  @default(0)
  errorCode          String?              @map("error_code")
  errorMessage       String?              @map("error_message")
  startedAt          DateTime?            @map("started_at")
  completedAt        DateTime?            @map("completed_at")
  deletedAt          DateTime?            @map("deleted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  resume             Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([status, createdAt])
  @@map("resume_analyses")
}

model AptitudeQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  version        Int      @default(1)
  category       String
  subTopic       String?  @map("sub_topic")
  difficulty     String
  questionText   String   @map("question_text")
  options        Json     @map("options_json")
  correctOption  String   @map("correct_option")
  explanation    String?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attemptItems   AptitudeAttemptItem[]
  @@index([status, category, difficulty])
  @@map("aptitude_questions")
}

model AssessmentAttempt {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid @map("user_id")
  mode            AttemptMode
  roundType       AttemptRoundType   @map("round_type")
  status          AttemptStatus      @default(CREATED)
  startedAt       DateTime?          @map("started_at")
  hardDeadlineAt  DateTime?          @map("hard_deadline_at")
  submittedAt     DateTime?          @map("submitted_at")
  autoSubmitted   Boolean            @default(false) @map("auto_submitted")
  failureReason   String?            @map("failure_reason")
  idempotencyKey  String?            @unique @map("idempotency_key")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  aptitudeItems   AptitudeAttemptItem[]
  codingItems     CodingAttemptItem[]
  codeRuns        CodeRun[]

  @@index([userId, mode, roundType, createdAt])
  @@map("assessment_attempts")
}

model AptitudeAttemptItem {
  id              String             @id @default(uuid()) @db.Uuid
  attemptId       String             @db.Uuid @map("attempt_id")
  questionId      String             @db.Uuid @map("question_id")
  position        Int
  selectedOption  String?            @map("selected_option")
  bookmarked      Boolean            @default(false)
  answeredAt      DateTime?          @map("answered_at")
  correct         Boolean?
  score           Decimal?           @db.Decimal(8, 2)
  explanationSnapshot Json?          @map("explanation_snapshot_json")
  attempt         AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        AptitudeQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, position])
  @@index([questionId])
  @@map("aptitude_attempt_items")
}

model CodingProblem {
  id                 String   @id @default(uuid()) @db.Uuid
  version            Int      @default(1)
  title              String
  difficulty         String
  problemType        String   @default("dsa") @map("problem_type")
  statementMarkdown  String   @map("statement_markdown")
  constraints       Json?
  examples           Json?
  signatures         Json?
  starterCode       Json?    @map("starter_code_json")
  visibleTests      Json?    @map("visible_tests_json")
  hiddenTests       Json?    @map("hidden_tests_encrypted")
  timeLimitMs       Int      @default(5000) @map("time_limit_ms")
  memoryLimitKb     Int      @default(262144) @map("memory_limit_kb")
  status            String   @default("draft")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  attemptItems      CodingAttemptItem[]

  @@index([status, difficulty, problemType])
  @@map("coding_problems")
}

model CodingAttemptItem {
  id             String            @id @default(uuid()) @db.Uuid
  attemptId      String            @db.Uuid @map("attempt_id")
  problemId      String            @db.Uuid @map("problem_id")
  position       Int
  language       String
  draftCode      String?           @map("draft_code")
  finalCode      String?           @map("final_code")
  sourceHash     String?           @map("source_hash")
  status         String            @default("draft")
  passedCount    Int               @default(0) @map("passed_count")
  totalCount     Int               @default(0) @map("total_count")
  score          Decimal?          @db.Decimal(8, 2)
  submittedAt    DateTime?         @map("submitted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem        CodingProblem     @relation(fields: [problemId], references: [id], onDelete: Restrict)
  codeRuns       CodeRun[]

  @@unique([attemptId, position])
  @@map("coding_attempt_items")
}

model CodeRun {
  id                String             @id @default(uuid()) @db.Uuid
  attemptId         String?            @db.Uuid @map("attempt_id")
  codingAttemptItemId String?          @db.Uuid @map("coding_attempt_item_id")
  language          String
  runtimeVersion    String             @map("runtime_version")
  sourceHash        String             @map("source_hash")
  inputHash         String?            @map("input_hash")
  status            String
  timeLimitMs       Int                @map("time_limit_ms")
  memoryLimitKb     Int                @map("memory_limit_kb")
  networkDisabled   Boolean            @default(true) @map("network_disabled")
  passedCount       Int                @default(0) @map("passed_count")
  totalCount        Int                @default(0) @map("total_count")
  runtimeMs         Int?               @map("runtime_ms")
  memoryKb          Int?               @map("memory_kb")
  outputMetadata    Json?              @map("output_metadata_json")
  failureCode       String?            @map("failure_code")
  createdAt         DateTime           @default(now()) @map("created_at")
  attempt           AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  codingAttemptItem CodingAttemptItem? @relation(fields: [codingAttemptItemId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@map("code_runs")
}

model InterviewSession {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid @map("user_id")
  mode                AttemptMode
  interviewType       String   @map("interview_type")
  status              String   @default("created")
  state               String   @default("created")
  targetDurationSecs  Int?     @map("target_duration_seconds")
  hardDeadlineAt      DateTime? @map("hard_deadline_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  reconnectDeadlineAt DateTime? @map("reconnect_deadline_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events              InterviewEvent[]
  turns               InterviewTurn[]
  reports             InterviewReport[]

  @@index([userId, createdAt])
  @@map("interview_sessions")
}

model InterviewEvent {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @db.Uuid @map("session_id")
  eventId     String           @map("event_id")
  sequence    Int
  eventType   String           @map("event_type")
  payload     Json             @map("payload_json")
  origin      String
  occurredAt  DateTime         @map("occurred_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@unique([sessionId, eventId])
  @@map("interview_events")
}

model InterviewTurn {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @db.Uuid @map("session_id")
  sequence    Int
  speaker     String
  inputType   String           @map("input_type")
  text        String?
  startedAt   DateTime?        @map("started_at")
  endedAt     DateTime?        @map("ended_at")
  metadata    Json?            @map("metadata_json")
  createdAt   DateTime         @default(now()) @map("created_at")
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@map("interview_turns")
}

model InterviewReport {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @db.Uuid @map("session_id")
  status       String
  reportVersion Int             @map("report_version")
  report       Json?            @map("report_json")
  generatedAt  DateTime?        @map("generated_at")
  errorCode    String?          @map("error_code")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("interview_reports")
}

model ConsentRecord {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid @map("user_id")
  consentType    ConsentType  @map("consent_type")
  captureScope   Json?        @map("capture_scope")
  policyVersion  String       @map("policy_version")
  accepted       Boolean
  acceptedAt     DateTime?    @map("accepted_at")
  withdrawnAt    DateTime?    @map("withdrawn_at")
  ipHash         String?      @map("ip_hash")
  userAgentHash  String?      @map("user_agent_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, createdAt])
  @@map("consent_records")
}

model DataRequest {
  id              String            @id @default(uuid()) @db.Uuid
  requestedById   String            @db.Uuid @map("requested_by")
  subjectUserId   String            @db.Uuid @map("subject_user_id")
  requestType     DataRequestType   @map("request_type")
  status          DataRequestStatus @default(REQUESTED)
  legalHold       Boolean           @default(false) @map("legal_hold")
  requestedAt     DateTime          @default(now()) @map("requested_at")
  dueAt           DateTime?         @map("due_at")
  exportAssetId   String?           @db.Uuid @map("export_asset_id")
  jobId           String?           @db.Uuid @map("job_id")
  approvedById    String?           @db.Uuid @map("approved_by")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  requestedBy     User              @relation("RequestedDataRequests", fields: [requestedById], references: [id], onDelete: Restrict)
  subjectUser     User              @relation("SubjectDataRequests", fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, status])
  @@map("data_requests")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  type           String
  payload        Json
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("queued")
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedAt       DateTime? @map("locked_at")
  completedAt    DateTime? @map("completed_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    String?   @db.Uuid @map("created_by_id")
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@map("jobs")
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid @map("user_id")
  type           String
  payload        Json     @map("payload_json")
  readAt         DateTime? @map("read_at")
  deliveryStatus String   @default("queued") @map("delivery_status")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @db.Uuid @map("actor_user_id")
  actorRole     String?  @map("actor_role")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  details       Json?    @map("details_json")
  ipHash        String?  @map("ip_hash")
  userAgentHash String?  @map("user_agent_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
