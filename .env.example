# Copy this file to .env and replace only the values required by your local setup.
# NEVER commit .env or real credentials to Git.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your-random-32-character-auth-secret-here

# -----------------------------------------------------------------------------
# Database
# PostgreSQL connection string (Neon / Supabase / local PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/interviewai?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/interviewai?sslmode=require

# -----------------------------------------------------------------------------
# AI Provider (server-side only)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-pro
GEMINI_RESUME_MODEL=gemini-2.0-flash
GEMINI_RESUME_TIMEOUT_MS=24000

# -----------------------------------------------------------------------------
# Google OAuth (server-side only)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIRECT_URL=http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# Email Delivery
# -----------------------------------------------------------------------------
# Approach A: Resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="I WITH AI <[EMAIL_ADDRESS]>"

# Approach B: SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# File / Media Storage (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=interviewai

# -----------------------------------------------------------------------------
# Cache, Sessions, & Queues (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379
CELERY_BROKER_URL=rediss://default:your-redis-password@your-redis-host:6379/1
CELERY_RESULT_BACKEND=rediss://default:your-redis-password@your-redis-host:6379/2

# -----------------------------------------------------------------------------
# Code Execution & Speech Processing
# -----------------------------------------------------------------------------
PISTON_API_URL=https://emkc.org/api/v2/piston
WHISPER_MODEL_SIZE=base

# -----------------------------------------------------------------------------
# Security & Feature Flags
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
JOB_WORKER_SECRET=your-job-worker-secret-here
ENABLE_AI=false
ENABLE_EMAIL=false
ENABLE_MEDIA_RECORDING=false
ENABLE_PROCTORING=false
