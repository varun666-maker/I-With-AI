{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/frontend/*": [
        "./frontend/*"
      ],
      "@/backend/*": [
        "./backend/*"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "@/components/screens/*": [
        "./frontend/screens/*"
      ],
      "@/components/*": [
        "./frontend/components/*"
      ],
      "@/hooks/*": [
        "./frontend/hooks/*"
      ],
      "@/lib/store": [
        "./frontend/stores/nav-store"
      ],
      "@/lib/flows": [
        "./frontend/config/flows"
      ],
      "@/lib/fullscreen": [
        "./frontend/hooks/use-fullscreen"
      ],
      "@/lib/proctoring": [
        "./frontend/services/proctoring"
      ],
      "@/lib/utm": [
        "./frontend/utils/utm"
      ],
      "@/lib/utils": [
        "./shared/utils/cn"
      ],
      "@/lib/db": [
        "./backend/db/client"
      ],
      "@/lib/server/*": [
        "./backend/services/*"
      ],
      "@/lib/*": [
        "./backend/runners/*",
        "./backend/data/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "trash"
  ]
}
